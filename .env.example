# Application
APP_NAME="MiiRAG Backend"
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://miirag:miirag@localhost:5432/miirag

# Embedding Model (Lokal BAAI/bge-m3 via PyTorch CUDA)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=16

# Google Vertex AI (Opsional jika ingin fallback ke cloud)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
EMBEDDING_MAX_RETRIES=3

# MinIO Object Storage (Page Snapshots)
MINIO_ENABLED=true
MINIO_FOLDER_PREFIX=documents
MINIO_ENDPOINT=minioapi.clientsolve.com
MINIO_BUCKET=evorag
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_REGION=us-east-1
MINIO_SECURE=true
MINIO_PUBLIC_URL=https://minioapi.clientsolve.com
MINIO_PRESIGNED_EXPIRY_SECONDS=1800

# PDF Processing & Storage
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PAGE_SNAPSHOT_DPI=150

# Vector Search & Hybrid Retrieval Tuning
HNSW_EF_SEARCH=64
DEFAULT_TOP_K=5
DEFAULT_SCORE_THRESHOLD=0.35
DEFAULT_SEARCH_MODE=hybrid
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=0.65
HYBRID_SPARSE_WEIGHT=0.35

# Cross-Encoder Reranking (Multilingual CPU/CUDA)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_DEVICE=cuda
RERANK_CANDIDATE_LIMIT=20
PRELOAD_MODELS=true

# Query Enhancement (HyDE / Expansion) - opsional: none | gemini | openai | ollama
HYDE_LLM_PROVIDER=none
HYDE_LLM_MODEL=gemini-2.5-flash
HYDE_API_KEY=
HYDE_BASE_URL=
HYDE_TIMEOUT_SECONDS=5.0

# Server Backend & MCP (Model Context Protocol)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MCP_ENABLED=true
MCP_SERVER_NAME=miirag-mcp
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_SSE_PATH=/sse
MCP_MESSAGE_PATH=/messages/
